{
  "name": "@superinference/core",
  "version": "0.7.3",
  "description": "Core AI code assistant engine for SuperInference",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --max-old-space-size=8192 --import tsx --test --test-force-exit test/*.test.ts",
    "test:coverage": "node --max-old-space-size=8192 --import tsx --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='node_modules/**' test/*.test.ts",
    "lint": "eslint src/",
    "lint:security": "eslint src/",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security": "npm run lint:security && npm run audit"
  },
  "dependencies": {
    "@ai-sdk/alibaba": "^2.0.78",
    "@ai-sdk/anthropic": "^4.0.90",
    "@ai-sdk/cerebras": "^3.0.80",
    "@ai-sdk/cohere": "^4.0.71",
    "@ai-sdk/deepinfra": "^3.0.80",
    "@ai-sdk/deepseek": "^3.0.75",
    "@ai-sdk/fireworks": "^3.0.83",
    "@ai-sdk/google": "^4.0.107",
    "@ai-sdk/google-vertex": "^5.0.125",
    "@ai-sdk/groq": "^4.0.72",
    "@ai-sdk/huggingface": "^2.0.80",
    "@ai-sdk/mistral": "^4.0.74",
    "@ai-sdk/openai": "^4.0.104",
    "@ai-sdk/togetherai": "^3.0.81",
    "@ai-sdk/xai": "^5.0.32",
    "ai": "^7.0.155",
    "tinyglobby": "^0.2.17",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "eslint": "^10.13.0",
    "eslint-plugin-security": "^4.2.0",
    "jscpd": "^5.4.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
