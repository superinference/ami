{
  "name": "@superinference/core",
  "version": "0.7.2",
  "description": "Core AI code assistant engine for SuperInference",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "test": "node --max-old-space-size=8192 --import tsx --test --test-force-exit test/*.test.ts",
    "test:coverage": "node --max-old-space-size=8192 --import tsx --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='node_modules/**' test/*.test.ts",
    "lint": "eslint src/ --ext .ts --max-warnings 0",
    "lint:security": "eslint src/ --ext .ts --max-warnings 0",
    "audit": "npm audit --omit=dev --audit-level=high",
    "security": "npm run lint:security && npm run audit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.83",
    "@ai-sdk/google": "^3.0.81",
    "@ai-sdk/google-vertex": "^4.0.144",
    "@ai-sdk/openai": "^3.0.70",
    "ai": "^6.0.202",
    "fast-glob": "^3.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^8.57.1",
    "eslint-plugin-security": "^4.0.0",
    "jscpd": "^4.2.4",
    "tsx": "^4.7.0",
    "typescript": "^5.9.3"
  }
}
